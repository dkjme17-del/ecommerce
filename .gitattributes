# Ces fichiers sont executes sur l'instance Ubuntu : les fins de ligne LF sont
# obligatoires (un CRLF fait echouer bash et nginx). On les fige pour que le
# core.autocrlf de Windows ne les corrompt pas au prochain clone.
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.conf text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf