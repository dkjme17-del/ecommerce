# URL d'origine du backend Express (uniquement l'hôte, sans /api/v1).
# Utilisée côté serveur (serverFetch) et par le proxy /api de next.config.mjs.
# En production : backend et frontend sur le même serveur -> http://localhost:4000
API_URL=http://localhost:4000

# Rétrocompatibilité : NEXT_PUBLIC_API_URL fonctionne encore, mais préférez API_URL.
# NEXT_PUBLIC_API_URL=http://localhost:4000