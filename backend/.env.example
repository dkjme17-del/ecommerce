# Application
NODE_ENV=production
PORT=4000
# Origines autorisées CORS (séparées par des virgules). En production,
# mettez l'URL publique du site : CLIENT_URL=https://shop.example.com
CLIENT_URL=http://localhost:3000

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce"

# Sécurité
# En production : générez une longue chaîne aléatoire (openssl rand -base64 48).
# L'API refusera de démarrer en production si JWT_SECRET n'est pas défini.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Commission plateforme (1%)
COMMISSION_RATE=0.01

# Paiement mobile money
# sandbox (défaut) = simulé  |  live = paiement réel via Wave
PAYMENT_MODE=sandbox
PAYMENT_SANDBOX_DELAY_MS=3000

# --- Intégration Wave (obligatoire si PAYMENT_MODE=live) ---
# Clé API depuis le portail développeur Wave : business.wave.com/developers.
# Wave ne fournit pas de sandbox : la clé est liée au portefeuille marchand réel.
# (ex. wave_sn_prod_...)
WAVE_API_KEY=

# Secret webhook fourni par Wave quand vous enregistrez votre URL de webhook
# (https://docs.wave.com/webhook). Requis en production pour vérifier les
# signatures Wave-Signature des notifications de paiement.
WAVE_WEBHOOK_SECRET=

# Uniquement si « request signing » est activé dans le portail Wave
WAVE_SIGNING_SECRET=

# Devise des montants (XOF par défaut, montants entiers)
WAVE_CURRENCY=XOF

# URLs de retour (par défaut construites depuis CLIENT_URL)
# WAVE_SUCCESS_URL=
# WAVE_ERROR_URL=
# WAVE_CANCEL_URL=

# --- Intégration GeniusPay (optionnel) ---
# Sans ces clés, PAYMENT_PROVIDER reste sur « sandbox » même si PAYMENT_MODE=live.
# PAYMENT_PROVIDER=geniuspay
# GENIUSPAY_API_KEY=
# GENIUSPAY_API_SECRET=
# GENIUSPAY_BASE_URL=https://api.geniuspay.com
# GENIUSPAY_WEBHOOK_SECRET=

# --- E-mails transactionnels (optionnel) ---
# MAIL_ENABLED=true active les e-mails (confirmation de commande, notification vendeur).
# Sans MAIL_ENABLED=true, les e-mails sont simplement ignorés.
# MAIL_ENABLED=false
# MAIL_FROM="DK Market <no-reply@example.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Payouts vendeurs (seuil minimum en FCFA)
MIN_PAYOUT_AMOUNT=5000

# Uploads (répertoire relatif à backend/)
UPLOAD_DIR=uploads
