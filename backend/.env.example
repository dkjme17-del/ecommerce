# Application
NODE_ENV=development
PORT=4000
# Origines autorisées CORS (séparées par des virgules). En production,
# mettez l'URL publique du site : CLIENT_URL=https://shop.example.com
CLIENT_URL=http://localhost:3000

# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce"

# Sécurité
# En production : générez une longue chaîne aléatoire (openssl rand -base64 48).
# L'API refusera de démarrer en production si JWT_SECRET n'est pas défini.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Secret partagé pour la signature HMAC-SHA256 des webhooks mobile money
# (header "x-momo-signature" = HMAC-SHA256 hex du corps brut de la requête).
# Obligatoire en production.
MOMO_WEBHOOK_SECRET=change-me-to-another-long-random-string

# Commission plateforme (5%)
COMMISSION_RATE=0.05

# Paiement mobile money
# sandbox = simulé  |  live = intégration réelle (kit officiel à implémenter)
PAYMENT_MODE=sandbox
PAYMENT_SANDBOX_DELAY_MS=3000

# Payouts vendeurs (seuil minimum en FCFA)
MIN_PAYOUT_AMOUNT=5000

# Uploads (répertoire relatif à backend/)
UPLOAD_DIR=uploads